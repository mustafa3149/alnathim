<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge, no ActionBar — the web app renders its own UI -->
    <style name="Theme.AlNathim" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/brand_white</item>
        <item name="android:windowBackground">@color/brand_white</item>
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorPrimaryDark">@color/brand_white</item>
        <item name="colorAccent">@color/brand_dark</item>
    </style>
</resources>