<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge, no ActionBar — the web app renders its own UI -->
    <style name="Theme.AlNathim" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorPrimaryDark">@color/brand_bg</item>
        <item name="colorAccent">@color/brand_dark</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>