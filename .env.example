# ── Database ──────────────────────────────────────────
# Local development:    leave DATABASE_URL empty → SQLite in %APPDATA%
# Production (Supabase): paste the connection string in DOUBLE QUOTES.
# ⚠️ NEVER commit the real .env — use this file only as a template.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# ── Flask Secret Key ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ REQUIRED in production. If you connect to PostgreSQL while
#    SECRET_KEY is still the default, the app REFUSES to boot.
SECRET_KEY=replace_me_with_a_random_64_hex_string

# ── SuperAdmin (used only on first run) ───────────────
SUPERADMIN_USERNAME=admin
# ⚠️ REQUIRED in production — see warning above.
SUPERADMIN_PASSWORD=replace_me_with_a_strong_password

# ── Registration & Sessions (Phase 14.4) ───────────────
# true  → self-registration on; accounts without invite code are pending (admin approves)
# false → self-registration disabled; only the Admin Center can create accounts
ALLOW_OPEN_REGISTRATION=true
# How long a login session stays valid (minutes). Default 480 (8 hours).
SESSION_LIFETIME_MINUTES=480

# ── Security Hardening (Phase 14.5) ─────────────────────
# After this many wrong passwords the account auto-suspends (admin reactivates).
MAX_FAILED_LOGINS=5
# Per-IP brute-force budget on /login and /register:
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5
# Only send the session cookie over HTTPS when true.
# Auto-true when DATABASE_URL is set (production). Keep false for local HTTP.
COOKIE_SECURE=false

# ── API Gateway Admin PIN / Password (Phase 8 auth) ───
# Default "1234" is for LOCAL TESTING ONLY — change before any real use.
ADMIN_PASSWORD=1234
# Optional: number of hours a login token stays valid (default 24).
AUTH_TOKEN_TTL_HOURS=24
